{
  "rewrites": [
    {
      "source": "/app",
      "destination": "/FotData.html"
    },
    {
      "source": "/m/:slug",
      "destination": "https://fotdata-api.onrender.com/share/match/:slug"
    },
    {
      "source": "/og/m/:file",
      "destination": "https://fotdata-api.onrender.com/og/match/:file"
    },
    {
      "source": "/cal/:file",
      "destination": "https://fotdata-api.onrender.com/calendar/:file"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), usb=(), browsing-topics=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/logos/hd/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!cal/).*)",
      "has": [
        {
          "type": "host",
          "value": "fotdata-api.vercel.app"
        }
      ],
      "destination": "https://www.fotdata-official.com/:path",
      "permanent": true
    },
    {
      "source": "/FotData.html",
      "destination": "/app",
      "permanent": true
    },
    {
      "source": "/app/",
      "destination": "/app",
      "permanent": true
    }
  ]
}
