{
  "rewrites": [
    {
      "source": "/m/:slug",
      "destination": "https://fotdata-api.onrender.com/share/match/:slug"
    },
    {
      "source": "/og/m/:file",
      "destination": "https://fotdata-api.onrender.com/og/match/:file"
    }
  ],
  "headers": [
    {
      "source": "/logos/hd/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    }
  ]
}
